<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Service Billing System
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/ServiceBillingSystem.styles.css"
          asp-append-version="true" />

</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-3">
            <div class="container-fluid">

                @if (Context.Session.GetString("UserId") != null)
                {
                    <a class="navbar-brand"
                       asp-controller="Users"
                       asp-action="@(Context.Session.GetString("Role") == "Admin" ? "AdminDashboard":"StaffDashboard")">
                        Service Billing System
                    </a>
                }
                else
                {
                    <span class="navbar-brand">
                        Service Billing System
                    </span>
                }
                <div class="navbar-collapse">

                    @if (Context.Session.GetString("UserId") != null)
                    {
                        <ul class="navbar-nav me-auto">

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Users"
                                   asp-action="@(Context.Session.GetString("Role") == "Admin" ? "AdminDashboard" : "StaffDashboard")">
                                    Dashboard
                                </a>
                            </li>


                            @if (Context.Session.GetString("Role") == "Staff")
                            {
                                @* Show Add Customer, Create Bill and Bills only when NOT on Staff Dashboard *@
                                @if (!(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users"
                                    && ViewContext.RouteData.Values["Action"]?.ToString() == "StaffDashboard"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="Customers"
                                           asp-action="Create">
                                            Add Customer
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="Bills"
                                           asp-action="Create">
                                            Create Bill
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="Bills"
                                           asp-action="Index">
                                            Bills
                                        </a>
                                    </li>
                                }
                            }


                            @if (Context.Session.GetString("Role") == "Admin")
                                {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Bills"
                                       asp-action="Index">
                                        Bills
                                    </a>
                                </li>

                                @* Show Staff and Services ONLY on Staff or Services pages *@

                                @if (
                                    (ViewContext.RouteData.Values["Controller"]?.ToString() == "Users"
                                     && ViewContext.RouteData.Values["Action"]?.ToString() == "Staff")
                                    ||
                                    (ViewContext.RouteData.Values["Controller"]?.ToString() == "Services"
                                     && ViewContext.RouteData.Values["Action"]?.ToString() == "Index")
                                )
                                {
                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="Users"
                                           asp-action="Staff">
                                            Staff
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="Services"
                                           asp-action="Index">
                                            Services
                                        </a>
                                    </li>
                                }

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Users"
                                       asp-action="AddAdmin">
                                        Add Admin
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Company"
                                       asp-action="Index">
                                        Company
                                    </a>
                                </li>
                                }    

                        </ul>


                        <span class="navbar-text me-3">
                            Welcome,
                            @Context.Session.GetString("UserName")
                        </span>

                        <a class="btn btn-danger"
                           asp-controller="Users"
                           asp-action="Logout">
                            Logout
                        </a>
                    }
                </div>

            </div>
        </nav>

    </header>


    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    
        <footer class="site-footer">
            <div>
                © 2026 - Service Billing System
            </div>
        </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>