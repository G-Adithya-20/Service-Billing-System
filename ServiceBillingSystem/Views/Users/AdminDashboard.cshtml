@model ServiceBillingSystem.Models.AdminDashboardViewModel

<div class="admin-dashboard">

    <div class="admin-content">

        <h2 class="text-center">
            Admin Dashboard
        </h2>

        <p class="text-center text-muted">
            Manage staff, services and billing
        </p>

        <hr />


        <br />


        <div class="row text-center">

            <div class="col-md-3 mb-3">
                <div class="card admin-card p-3">
                    <h5>Total Staff</h5>
                    <h2>@Model.TotalStaff</h2>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card admin-card p-3">
                    <h5>Total Customers</h5>
                    <h2>@Model.TotalCustomers</h2>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card admin-card p-3">
                    <h5>Total Services</h5>
                    <h2>@Model.TotalServices</h2>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card admin-card p-3">
                    <h5>Total Bills</h5>
                    <h2>@Model.TotalBills</h2>
                </div>
            </div>

        </div>

        <br />

        <!-- Admin Options -->

        <h4 class="text-center mb-3">
            Quick Actions
        </h4>

        <div class="row text-center">

            <div class="col-md-6 mb-3">

                <a asp-controller="Users"
                   asp-action="Staff"
                   class="admin-option">

                    <div class="admin-option-icon">
                        👥
                    </div>

                    <h5>Manage Staff</h5>

                    <p>
                        Add and manage staff members
                    </p>

                    <span class="btn btn-primary">
                        Manage Staff
                    </span>

                </a>

            </div>


            <div class="col-md-6 mb-3">

                <a asp-controller="Services"
                   asp-action="Index"
                   class="admin-option">

                    <div class="admin-option-icon">
                        🛠️
                    </div>

                    <h5>Manage Services</h5>

                    <p>
                        Add and manage billing services
                    </p>

                    <span class="btn btn-success">
                        Manage Services
                    </span>

                </a>

            </div>

        </div>

    </div>

</div>