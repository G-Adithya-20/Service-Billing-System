@model IEnumerable<ServiceBillingSystem.Models.User>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
<div class="staff-management">

    <div class="staff-management-box">

        <div class="staff-header">

            <div>
                <h2>Staff Management</h2>
                <p class="text-muted">
                    Manage staff members
                </p>
            </div>

            <a asp-controller="Users"
               asp-action="AddStaff"
               class="btn btn-primary">

                + Add Staff

            </a>

        </div>

        <hr />

        <table class="table table-bordered table-hover">

            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var staff in Model)
                {
                    <tr>

                        <td>@staff.Id</td>

                        <td>@staff.Name</td>

                        <td>@staff.Email</td>

                        <td>@staff.Role</td>

                        <td>
                            @if (staff.IsActive)
                            {
                                <form asp-controller="Users"
                                      asp-action="DeactivateStaff"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@staff.Id" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Deactivate
                                    </button>

                                </form>
                            }
                            else
                            {
                                <span class="text-danger">
                                    Inactive
                                </span>
                            }
                        </td>
                    </tr>
                }

            </tbody>

        </table>

        <a asp-controller="Users"
           asp-action="AdminDashboard"
           class="btn btn-secondary">

            Back to Dashboard

        </a>

    </div>

</div>