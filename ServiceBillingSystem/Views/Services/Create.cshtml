@model ServiceBillingSystem.Models.Service

<div class="service-create-page">

    <div class="service-create-box">

        <div class="service-create-header">
            <h2>Add Service</h2>
            <p>Enter the details of the new service.</p>
        </div>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="Enter service name" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Enter service description"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>

                <input asp-for="Price"
                       type="number"
                       step="0.01"
                       class="form-control"
                       placeholder="Enter price" />

                <span asp-validation-for="Price"
                      class="text-danger">
                </span>
            </div>

            <div class="service-create-buttons">
                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-success">
                    Add Service
                </button>
            </div>

        </form>

    </div>

</div>